# 로컬 개발용 환경 변수. 이 파일을 .env 로 복사해서 값을 채운다.
# 실제 값이 담긴 .env 는 절대 커밋하지 않는다.
# 운영(Render / GitHub Actions)에서는 각 플랫폼의 시크릿으로 주입한다.

# --- PostgreSQL ---------------------------------------------------------
# 운영은 Supabase Supavisor 트랜잭션 풀러(6543)를 쓴다.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=postgres
# 테스트가 쓰는 별도 DB. 비워 두면 테스트를 건너뛴다.
POSTGRES_TEST_DB=

# --- 커넥션 풀 ----------------------------------------------------------
DB_POOL_MAX_SIZE=5
DB_POOL_MAX_IDLE=300

# --- API ----------------------------------------------------------------
# 크롤러가 결과를 올릴 API 주소.
API_BASE_URL=http://localhost:8000/api
# 쓰기 엔드포인트를 여는 토큰. 비워 두면 쓰기가 막힌다.
API_WRITE_TOKEN=
# 브라우저에서 접근을 허용할 출처. 쉼표로 구분한다.
CORS_ALLOW_ORIGINS=http://localhost:5173

# --- 수집 ---------------------------------------------------------------
# 로그인 없이 모을 수 있는 플랫폼만 켠다. X·인스타그램은 로그인이 필요해 뺐다.
SNS_PLATFORMS=youtube
# 이보다 오래된 수집분은 지운다.
SNS_RETENTION_DAYS=90
